<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>Alief Ibnu Hamdani — Fullstack & Backend Developer</title>
		<meta name="description" content="Portfolio Alief Ibnu Hamdani - Fullstack & Backend Developer spesialis Next.js, NestJS, Laravel, Vue.js, dan Supabase." />
