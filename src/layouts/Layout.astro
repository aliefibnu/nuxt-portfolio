---
import '../styles/global.css'
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>Alief Ibnu Hamdani — Fullstack & Backend Developer</title>
		<meta name="description" content="Portfolio Alief Ibnu Hamdani: Fullstack & Backend Developer yang berfokus pada pengembangan aplikasi web modern dengan Next.js, NestJS, Laravel, dan Vue.js." />
		<meta name="keywords" content="Alief Ibnu Hamdani, Fullstack Developer, Backend Developer, Next.js, NestJS, Laravel, Vue.js, Supabase, Portfolio" />
		<meta name="author" content="Alief Ibnu Hamdani" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href="https://aliefibnu.com/" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Alief Ibnu Hamdani Portfolio" />
		<meta property="og:url" content="https://aliefibnu.com/" />
		<meta property="og:title" content="Alief Ibnu Hamdani — Fullstack & Backend Developer" />
		<meta property="og:description" content="Portfolio Alief Ibnu Hamdani: Fullstack & Backend Developer yang berfokus pada pengembangan aplikasi web modern dengan Next.js, NestJS, Laravel, dan Vue.js." />
		<meta property="og:image" content="https://aliefibnu.com/alief.jpg" />
		<meta property="og:locale" content="id_ID" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content="https://aliefibnu.com/" />
		<meta name="twitter:title" content="Alief Ibnu Hamdani — Fullstack & Backend Developer" />
		<meta name="twitter:description" content="Portfolio Alief Ibnu Hamdani: Fullstack & Backend Developer yang berfokus pada pengembangan aplikasi web modern dengan Next.js, NestJS, Laravel, dan Vue.js." />
		<meta name="twitter:image" content="https://aliefibnu.com/alief.jpg" />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Alief Ibnu Hamdani",
				"jobTitle": "Fullstack & Backend Developer",
				"url": "https://aliefibnu.com/",
				"sameAs": [
					"https://github.com/aliefibnu",
					"https://linkedin.com/in/aliefibnu",
					"https://instagram.com/aliefibnu",
					"https://tiktok.com/@aliefibnu"
				],
				"knowsAbout": [
					"Fullstack Development",
					"Backend Development",
					"Next.js",
					"NestJS",
					"Laravel",
					"Vue.js",
					"Supabase",
					"REST API"
				]
			}
		</script>

		<!-- Google Fonts: Playfair Display (Headings), Plus Jakarta Sans (Body), JetBrains Mono (Code/Tech) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased font-['Plus_Jakarta_Sans',sans-serif] selection:bg-slate-900 selection:text-white">
		<slot />
	</body>
</html>
